# Agent kamera → API di Render. Salin ke .env.render lalu isi token.
PF_API_URL=https://sts-photofinish.onrender.com
# Token dari Shell Render: npm run token:device -w api -- agent "Kamera Finish"
PF_DEVICE_TOKEN=
# Satu kamera = satu nama. Kamera kedua? pakai cam-2 (dan token sendiri).
PF_CAMERA_ID=cam-1
# Rekaman diunggah ke Render (salinan tetap di data/captures komputer ini)
PF_UPLOAD_CAPTURES=on
# Photocell virtual dari gambar kamera
PF_TRIGGER=camera
# Kamera, fps, resolusi & garis finish diatur dari halaman Pengaturan Kamera.
