{
  "name": "sts-photofinish",
  "private": true,
  "description": "STS Photo Finish \u2014 photo finish arung jeram & kayak, terhubung ke sts-timingsystem",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w api && npm run build -w web",
    "test": "npm test -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "setup": "bash scripts/setup.sh",
    "prod:start": "pm2 start ecosystem.config.cjs",
    "prod:stop": "pm2 stop ecosystem.config.cjs",
    "prod:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "prod:status": "pm2 status",
    "prod:logs": "pm2 logs --lines 100",
    "prod:delete": "pm2 delete ecosystem.config.cjs",
    "dev:local": "bash scripts/dev-local.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "js-yaml": "^5.4.2"
  }
}
