# Salin ke .env lalu isi. Jangan commit .env.
# Buat secret acak:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------- API (api/)
PF_HOST=0.0.0.0
PF_PORT=4100
# VPS di belakang Nginx: PF_HOST=127.0.0.1 dan PF_TRUST_PROXY=true
PF_TRUST_PROXY=false
# Database. Pilihan:
#  a) MongoDB Atlas yang SAMA dengan sts-timingsystem (cluster & akun sama,
#     database terpisah) — salin connection string Atlas timing ke sini, lalu
#     PF_MONGO_DB=sts_photofinish dan PF_PM2_MONGO=off. Butuh internet.
#     Tulis DENGAN tanda kutip (berisi &): PF_MONGO_URL="mongodb://…&…"
#  b) MongoDB lokal di laptop (offline): mongodb://127.0.0.1:27018
PF_MONGO_URL=mongodb://127.0.0.1:27018
PF_MONGO_DB=sts_photofinish
# Database sts-timingsystem di cluster yang sama — HANYA dibaca untuk nama Event
# (pilih Event berdasarkan nama). Kosongkan bila timing memakai MongoDB lain.
PF_TIMING_DB=sustainabledb_atlas
# Production (npm run prod:start): folder data MongoDB & apakah PM2 ikut
# menjalankan MongoDB / agent kamera (off bila dijalankan di tempat lain).
# PF_MONGO_DBPATH=./data/mongo
# PF_PM2_MONGO=on
# PF_PM2_AGENT=on
PF_JWT_SECRET=
# Sama persis dengan PF_HMAC_SECRET di .env sts-timingsystem
PF_HMAC_SECRET=
PF_FILE_URL_SECRET=
# Origin Web App (tambahkan IP LAN bila dibuka dari tablet, mis. http://192.168.1.10:5173)
PF_CORS_ORIGINS=http://localhost:5173
# PF_CAPTURES_DIR=./data/captures
# Aturan FAJI: akurasi 1/100 dtk. truncate | round — konfirmasi ke Chief Judge.
PF_OFFICIAL_ROUNDING=truncate

# ---------------- Capture Agent (agent/)
PF_API_URL=http://127.0.0.1:4100
# npm run token:device -w api -- agent "Kamera Finish"
PF_DEVICE_TOKEN=
PF_CAMERA_ID=cam-1
# Angka = kamera USB, rtsp://… = kamera IP, path file = replay video untuk uji
PF_CAMERA_SOURCE=0
PF_CAMERA_FPS=240
# Garis finish di frame (x1,y1,x2,y2), sejajar tiang photocell. Cek dengan: pf-agent --preview
PF_FINISH_LINE=
PF_BUFFER_SECONDS=20

# Photocell virtual: picu rekaman otomatis saat benda/perahu menyentuh garis finish
# di gambar kamera (tanpa klik). camera = aktif, off = hanya dari RaceTime2.
PF_TRIGGER=camera
# Kepekaan: selisih warna minimal (0–255) & panjang benda minimal (fraksi garis).
# Naikkan bila riak/percikan air ikut memicu; turunkan bila perahu terlewat.
PF_TRIGGER_THRESHOLD=30
PF_TRIGGER_MIN_RUN=0.06
# Garis harus bersih selama ini (detik) sebelum boleh memicu lagi.
PF_TRIGGER_RELEASE_S=0.5

# Arsip frame utuh: foto kamera asli di samping slit-scan (tinjauan frame demi
# frame, proporsi perahu tidak gepeng). Batasi fps & lebar agar ringan.
PF_FRAMES=on
PF_FRAMES_FPS=60
PF_FRAMES_WIDTH=1280
PF_FRAMES_QUALITY=85

# Mode VPS (API di server, agent di lokasi): unggah file rekaman lewat HTTPS.
# Di laptop lokasi: PF_API_URL=https://domain-anda & PF_UPLOAD_CAPTURES=on.
PF_UPLOAD_CAPTURES=off
